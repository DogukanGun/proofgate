# Copy to .env and fill in. .env is gitignored — never commit a real key.

# --- Hedera network ---
HEDERA_NETWORK=testnet
PROOFGATE_MIRROR_ENDPOINTS=https://testnet.mirrornode.hedera.com

# --- The payer (demo client only; the GATEWAY never holds a key) ---
# From https://portal.hedera.com — testnet account, funded with 1000 HBAR/day.
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# --- The payee. Must NOT equal the payer: a self-transfer satisfies the
# amount predicate while demonstrating nothing. scripts/setup_treasury.py
# creates one and prints its id.
PROOFGATE_PAY_TO=0.0.xxxxxx

# --- Pricing ---
PROOFGATE_ASSET=HBAR
PROOFGATE_PRICE_TINYBAR=10000000   # 0.1 HBAR

# --- Verification policy ---
PROOFGATE_FRESHNESS_WINDOW_S=180
PROOFGATE_CLOCK_SKEW_S=5
PROOFGATE_CROSSCHECK_MODE=receipt  # off | receipt | record

# --- Service ---
PROOFGATE_PUBLIC_URL=http://localhost:8787
PROOFGATE_PORT=8787
# Must be the externally reachable URL. Behind a proxy, request.url is the
# internal address and every payment would fail resource binding.
